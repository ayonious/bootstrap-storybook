{
  "name": "@ayonious/bootstrap-storybook",
  "version": "1.0.0",
  "description": "A simple React component playground powered by Storybook and Vite",
  "scripts": {
    "docs": "storybook dev -p 9001",
    "docs:build": "storybook build -o storybook-static",
    "build": "yarn docs:build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "unit-test": "yarn test",
    "test:stories": "vitest run --project storybook",
    "test:all": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayonious/bootstrap-storybook.git"
  },
  "author": "Nahiyan Kamal",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ayonious/bootstrap-storybook/issues"
  },
  "homepage": "https://github.com/ayonious/bootstrap-storybook#readme",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "styled-components": "^6.6.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
